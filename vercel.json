{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",           "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "redirects": [
    { "source": "/about-us/",                            "destination": "/about-us.html",                          "permanent": true },
    { "source": "/about-us",                             "destination": "/about-us.html",                          "permanent": true },
    { "source": "/contact-us/",                          "destination": "/contact-us.html",                        "permanent": true },
    { "source": "/contact-us",                           "destination": "/contact-us.html",                        "permanent": true },
    { "source": "/services-project-management/",         "destination": "/services-project-management.html",       "permanent": true },
    { "source": "/services-project-management",          "destination": "/services-project-management.html",       "permanent": true },
    { "source": "/services-spotify/",                    "destination": "/services-spotify.html",                  "permanent": true },
    { "source": "/services-spotify-2/",                  "destination": "/services-spotify.html",                  "permanent": true },
    { "source": "/services-spotify",                     "destination": "/services-spotify.html",                  "permanent": true },
    { "source": "/services-youtube/",                    "destination": "/services-youtube.html",                  "permanent": true },
    { "source": "/services-youtube",                     "destination": "/services-youtube.html",                  "permanent": true },
    { "source": "/services-tiktok/",                     "destination": "/services-tiktok.html",                   "permanent": true },
    { "source": "/services-tiktok",                      "destination": "/services-tiktok.html",                   "permanent": true },
    { "source": "/instagram/",                           "destination": "/services-instagram.html",                "permanent": true },
    { "source": "/instagram",                            "destination": "/services-instagram.html",                "permanent": true },
    { "source": "/servizi/",                             "destination": "/services-project-management.html",       "permanent": true },
    { "source": "/servizi",                              "destination": "/services-project-management.html",       "permanent": true },
    { "source": "/produzione-video/",                    "destination": "/services-project-management.html",       "permanent": true },
    { "source": "/produzione-video",                     "destination": "/services-project-management.html",       "permanent": true },
    { "source": "/majorlabel-service/",                  "destination": "/services-project-management.html",       "permanent": true },
    { "source": "/majorlabel-service",                   "destination": "/services-project-management.html",       "permanent": true },
    { "source": "/application-progress/",                "destination": "/contact-us.html",                        "permanent": true },
    { "source": "/application-progress",                 "destination": "/contact-us.html",                        "permanent": true },
    { "source": "/privacy-policy/",                      "destination": "/privacy-policy.html",                    "permanent": true },
    { "source": "/privacy-policy",                       "destination": "/privacy-policy.html",                    "permanent": true },
    { "source": "/terms-conditions/",                    "destination": "/terms.html",                             "permanent": true },
    { "source": "/terms-conditions",                     "destination": "/terms.html",                             "permanent": true },
    { "source": "/cookie-policy/",                       "destination": "/privacy-policy.html",                    "permanent": true },
    { "source": "/cookie-policy",                        "destination": "/privacy-policy.html",                    "permanent": true },

    { "source": "/portfolio/:slug*",                     "destination": "/about-us.html",                          "permanent": true },

    { "source": "/hello-world/",                                          "destination": "/", "permanent": true },
    { "source": "/winning-tactics-for-a-new-digital-agency/",             "destination": "/", "permanent": true },
    { "source": "/how-to-make-your-product-stand-out/",                   "destination": "/", "permanent": true },
    { "source": "/choose-from-meeting-speak-client-feedback/",            "destination": "/", "permanent": true },
    { "source": "/how-to-be-more-productive-usgin-sticky-notes/",         "destination": "/", "permanent": true },
    { "source": "/how-to-drive-your-customer-experience/",                "destination": "/", "permanent": true },
    { "source": "/six-cover-letter-greetings-for-every-situation/",       "destination": "/", "permanent": true },
    { "source": "/a-comprehensive-guide-to-local-seo/",                   "destination": "/", "permanent": true },
    { "source": "/how-to-become-a-best-sale-marketer-in-a-year/",         "destination": "/", "permanent": true },
    { "source": "/linkedin-just-relaunched-company-pages/",               "destination": "/", "permanent": true },

    { "source": "/wp-content/:path*",  "destination": "/",                                 "permanent": false },
    { "source": "/wp-admin/:path*",    "destination": "/",                                 "permanent": false },
    { "source": "/wp-includes/:path*", "destination": "/",                                 "permanent": false },
    { "source": "/wp-login.php",       "destination": "/",                                 "permanent": false },
    { "source": "/wp-json/:path*",     "destination": "/",                                 "permanent": false },
    { "source": "/feed/",              "destination": "/",                                 "permanent": false },
    { "source": "/feed",               "destination": "/",                                 "permanent": false },
    { "source": "/wp-sitemap.xml",     "destination": "/sitemap.xml",                      "permanent": true },
    { "source": "/wp-sitemap-:path*",  "destination": "/sitemap.xml",                      "permanent": true }
  ]
}
